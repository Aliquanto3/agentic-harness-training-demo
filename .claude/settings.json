{
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": { "source": "github", "repo": "DietrichGebert/ponytail" }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "permissions": {
    "allow": [
      "Bash(uv run --with playwright==1.56.0 python tools/e2e/run_e2e.py *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format --check *)",
      "Bash(python .claude/cost-kit/controle_rapide.py)"
    ],
    "deny": [
      "Read(./.venv/**)",
      "Read(./**/__pycache__/**)",
      "Read(./node_modules/**)",
      "Read(/models/**)",
      "Read(./data/indexes/**)",
      "Read(./**/*.gguf)",
      "Read(./**/*.safetensors)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
